// ==========================================
// Experiment 12: MongoDB CRUD Operations (mongosh)
// ==========================================

// Step 1: Select / Switch to database
use fsdDB

// Operation 1 — CREATE: Insert student records
db.students.insertMany([
  { student_id: 1, name: "Rohit Kumar", dept: "CSE", marks: 85 },
  { student_id: 2, name: "Ananya Sharma", dept: "ISE", marks: 90 },
  { student_id: 3, name: "Vikram Rao", dept: "CSE", marks: 78 }
])

// Operation 2 — READ: Display all students
db.students.find().pretty()

// Operation 3 — READ with condition: Filter by department
db.students.find({ dept: "CSE" })

// Operation 4 — UPDATE: Change student marks (Rohit Kumar: 85 -> 92)
db.students.updateOne(
  { student_id: 1 },
  { $set: { marks: 92 } }
)

// Operation 5 — DELETE: Delete a student (Vikram Rao)
db.students.deleteOne({ student_id: 3 })

// Operation 6 — Verify the final collection (Only Rohit & Ananya remain)
db.students.find().pretty()
